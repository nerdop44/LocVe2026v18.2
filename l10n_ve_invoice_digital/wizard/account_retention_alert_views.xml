<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_retention_alert_wizard" model="ir.ui.view">
        <field name="name">account.retention.alert.wizard.form</field>
        <field name="model">account.retention.alert.wizard</field>
        <field name="arch" type="xml">
            <form string="Alerta de Secuencia TFHKA (LocVe)">
                <field name="message" readonly="True"/>
                <footer>
                    <button name="action_confirm" string="Aceptar y Continuar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
