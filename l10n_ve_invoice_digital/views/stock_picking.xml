<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_inherit_tfhka_locve" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.tfhka.locve</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="show_digital_dispatch_guide" invisible="1"/>
                <field name="is_digitalized" string="Digitalizado TFHKA" invisible="show_digital_dispatch_guide" readonly="True"/>
                <field name="control_number_tfhka" string="Número Control TFHKA" invisible="show_digital_dispatch_guide" readonly="True"/>
            </xpath>
        </field>
    </record>
</odoo>
