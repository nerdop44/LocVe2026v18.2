<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_retention_iva_form_l10n_ve_payment_extension_inherit_tfhka" model="ir.ui.view">
        <field name="name">account.retention.iva.form.inherit.tfhka.locve</field>
        <field name="model">account.retention</field>
        <field name="inherit_id" ref="l10n_ve_payment_extension.view_retention_iva_form_locve_payment_extension" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="show_digital_retention_iva" invisible="1"/>
                <field name="control_number_tfhka" invisible="1"/>
                <button name="generate_document_digital" string="Generar Retención Digital IVA" type="object"
                        context="{'document_type': '05'}" 
                        class="btn-primary"
                        invisible="show_digital_retention_iva"/>
                <button name="action_send_retention_email" string="Enviar por Correo" type="object"
                        icon="fa-envelope"
                        class="btn-secondary"
                        invisible="not is_digitalized"/>

            </xpath>
            <xpath expr="//field[@name='type']" position="before">
                <field name="is_digitalized" string="Digitalizado TFHKA" readonly="True"/>
            </xpath>
            <xpath expr="//field[@name='number']" position="after">
                <field name="control_number_tfhka" string="Número Control TFHKA" readonly="True"/>
            </xpath>
        </field>
    </record>
</odoo>
