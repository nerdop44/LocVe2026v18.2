<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_tfhka_locve" model="ir.ui.view">
        <field name="name">account.move.form.inherit.tfhka.locve</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="show_digital_invoice" invisible="1"/>
                <field name="show_digital_credit_note" invisible="1"/>
                <field name="show_digital_debit_note" invisible="1"/>
                <button name="generate_document_digital" string="Generar Factura Digital TFHKA" type="object" 
                    class="btn-primary"
                    invisible="show_digital_invoice"/>
                <button name="generate_document_digital" string="Generar Nota de Crédito Digital" type="object" 
                    class="btn-primary"
                    invisible="show_digital_credit_note"/>
                <button name="generate_document_digital" string="Generar Nota de Débito Digital" type="object" 
                    class="btn-primary"
                    invisible="show_digital_debit_note"/>            
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="is_digitalized" string="Digitalizado TFHKA" invisible="move_type not in ['out_invoice', 'out_refund']" readonly="True"/>
            </xpath>
        </field>
    </record>
</odoo>
