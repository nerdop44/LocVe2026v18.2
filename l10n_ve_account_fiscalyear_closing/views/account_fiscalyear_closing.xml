<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_fiscal_year_closing_inherit_locve" model="ir.ui.view">
        <field name="name">account.fiscal.year.closing.view.form.inherit</field>
        <field name="model">account.fiscalyear.closing</field>
        <field name="inherit_id" ref="account_fiscal_year_closing.view_account_fiscalyear_closing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_revert_revaluation" string="Revertir Revaluación" type="object"
                        invisible="not revaluation_executed or state != 'calculated'"/>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="revaluation_executed" readonly="1"/>
                <field name="revaluation_move_ids" widget="many2many_tags" readonly="1" invisible="not revaluation_move_ids"/>
            </xpath>
            <xpath expr="//field[@name='move_config_ids']//sheet//field[@name='sequence']" position="after">
                <label for="l_map"/>
                <div>
                    <field  name="l_map" string="Load Accounts"/>
                </div>
            </xpath>
            <!-- <xpath expr="//sheet[1]//sheet[1]//field[@name='inverse']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath> -->
        </field>
    </record>

</odoo>
