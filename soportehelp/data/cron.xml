<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_soportehelp_inventory" model="ir.cron">
            <field name="name">Soporte: Inventario de módulos</field>
            <field name="model_id" ref="model_soportehelp_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_inventory()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
        <record id="cron_soportehelp_heartbeat" model="ir.cron">
            <field name="name">Soporte: Heartbeat</field>
            <field name="model_id" ref="model_soportehelp_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_run_heartbeat()</field>
            <field name="interval_number">24</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
        <record id="cron_soportehelp_monitor" model="ir.cron">
            <field name="name">Soporte: Monitoreo de versiones</field>
            <field name="model_id" ref="model_soportehelp_core"/>
            <field name="state">code</field>
            <field name="code">model._monitor_versions()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
