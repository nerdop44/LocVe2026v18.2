<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_soportehelp_ticket" model="ir.actions.act_window">
            <field name="name">Mis Tickets</field>
            <field name="res_model">soportehelp.ticket</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p>Envíe y dé seguimiento a sus solicitudes de soporte.</p>
            </field>
        </record>

        <record id="action_soportehelp_ticket_new" model="ir.actions.act_window">
            <field name="name">Nuevo Ticket</field>
            <field name="res_model">soportehelp.ticket</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Menú Principal del Cliente: Solamente "Nuevo Ticket" y "Mis Tickets" -->
        <menuitem id="menu_soporte_ayuda_root" name="Soporte y Ayuda"
                  web_icon="soportehelp,static/description/icon.png"
                  action="action_soportehelp_ticket"
                  sequence="110"/>

        <menuitem id="menu_soporte_ayuda_new_ticket" name="Nuevo Ticket"
                  parent="menu_soporte_ayuda_root"
                  sequence="10"
                  action="action_soportehelp_ticket_new"/>

        <menuitem id="menu_soporte_ayuda_my_tickets" name="Mis Tickets"
                  parent="menu_soporte_ayuda_root"
                  sequence="20"
                  action="action_soportehelp_ticket"/>
    </data>
</odoo>