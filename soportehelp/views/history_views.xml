<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="soportehelp_history_tree" model="ir.ui.view">
        <field name="name">soportehelp.history.list</field>
        <field name="model">soportehelp.history</field>
        <field name="arch" type="xml">
            <list string="Actividad">
                <field name="timestamp"/>
                <field name="event_type"/>
                <field name="module_name"/>
                <field name="version_from"/>
                <field name="version_to"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="soportehelp_history_form" model="ir.ui.view">
        <field name="name">soportehelp.history.form</field>
        <field name="model">soportehelp.history</field>
        <field name="arch" type="xml">
            <form string="Detalle de Actividad">
                <group>
                    <group>
                        <field name="timestamp" readonly="1"/>
                        <field name="event_type" readonly="1"/>
                    </group>
                    <group>
                        <field name="module_name" readonly="1"/>
                        <field name="version_from" readonly="1"/>
                        <field name="version_to" readonly="1"/>
                    </group>
                </group>
                <field name="message"/>
            </form>
        </field>
    </record>

    <record id="soportehelp_maintenance_apply_form" model="ir.ui.view">
        <field name="name">soportehelp.maintenance.apply.form</field>
        <field name="model">soportehelp.maintenance.apply</field>
        <field name="arch" type="xml">
            <form string="Aplicar Pase de Mantenimiento">
                <group>
                    <field name="note" readonly="1"/>
                    <field name="token" placeholder="Pegue aquí el token de mantenimiento"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>