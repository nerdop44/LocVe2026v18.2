<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Lista (Tree/List) -->
    <record id="view_l10n_ve_audit_log_tree" model="ir.ui.view">
        <field name="name">l10n_ve.audit.log.tree</field>
        <field name="model">l10n_ve.audit.log</field>
        <field name="arch" type="xml">
            <list string="Registro de Auditoría Fiscal" create="false" edit="false" delete="false" duplicate="false">
                <field name="datetime" decoration-bf="1"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="action" widget="badge" 
                       decoration-success="action == 'post'" 
                       decoration-warning="action in ['draft', 'cancel', 'reversal']" 
                       decoration-danger="action == 'unlink'"
                       decoration-info="action == 'create'"/>
                <field name="res_model"/>
                <field name="record_name"/>
                <field name="details" class="text-truncate"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Vista de Formulario -->
    <record id="view_l10n_ve_audit_log_form" model="ir.ui.view">
        <field name="name">l10n_ve.audit.log.form</field>
        <field name="model">l10n_ve.audit.log</field>
        <field name="arch" type="xml">
            <form string="Detalle de Auditoría Fiscal" create="false" edit="false" delete="false" duplicate="false">
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Evento de Auditoría Fiscal</span>
                        <h1>
                            <field name="record_name" placeholder="Sin nombre"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detalles Básicos">
                            <field name="datetime"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Datos Técnicos">
                            <field name="action"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                        </group>
                    </group>
                    <group string="Contenido / Cambios Registrados">
                        <field name="details" placeholder="Detalle técnico del evento..." nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda -->
    <record id="view_l10n_ve_audit_log_search" model="ir.ui.view">
        <field name="name">l10n_ve.audit.log.search</field>
        <field name="model">l10n_ve.audit.log</field>
        <field name="arch" type="xml">
            <search string="Buscar Logs de Auditoría">
                <field name="record_name" string="Nombre / Control / Guía / ID"/>
                <field name="user_id"/>
                <field name="res_model"/>
                <separator/>
                <filter string="Creaciones" name="filter_create" domain="[('action', '=', 'create')]"/>
                <filter string="Publicaciones" name="filter_post" domain="[('action', '=', 'post')]"/>
                <filter string="Cancelaciones" name="filter_cancel" domain="[('action', '=', 'cancel')]"/>
                <filter string="Reversiones" name="filter_reversal" domain="[('action', '=', 'reversal')]"/>
                <filter string="Eliminaciones" name="filter_unlink" domain="[('action', '=', 'unlink')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Usuario" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Acción" name="group_action" context="{'group_by': 'action'}"/>
                    <filter string="Modelo Técnico" name="group_model" context="{'group_by': 'res_model'}"/>
                    <filter string="Fecha (Día)" name="group_date" context="{'group_by': 'datetime:day'}"/>
                    <filter string="Compañía" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana (ir.actions.act_window) -->
    <record id="action_l10n_ve_audit_log" model="ir.actions.act_window">
        <field name="name">Tabla de Auditoría Fiscal</field>
        <field name="res_model">l10n_ve.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_ve_audit_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay registros de auditoría fiscal.
            </p>
            <p>
                Los eventos de facturación y movimientos contables clave se registrarán aquí automáticamente para el control del SENIAT.
            </p>
        </field>
    </record>
</odoo>
