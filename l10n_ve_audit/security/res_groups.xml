<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categoría de Seguridad Dedicada -->
    <record id="module_category_l10n_ve_audit" model="ir.module.category">
        <field name="name">Auditoría Fiscal (SENIAT)</field>
        <field name="description">Permisos para el control de auditoría fiscal del SENIAT.</field>
        <field name="sequence">100</field>
    </record>

    <!-- Grupo de Seguridad del Auditor -->
    <record id="group_fiscal_auditor" model="res.groups">
        <field name="name">Auditor Fiscal (SENIAT)</field>
        <field name="category_id" ref="module_category_l10n_ve_audit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Acceso restringido y de solo lectura a la contabilidad y tablas de logs para auditorías del SENIAT.</field>
    </record>
</odoo>
