<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_hr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Vendedores" id="pos_salesman_section">
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="pos_salesman_setting">
                            <div class="o_setting_right_pane">
                                <label for="pos_salesman_ids" string="Vendedores Permitidos" class="fw-normal"/>
                                <div class="text-muted">
                                    Configura los vendedores que pueden operar en este POS
                                </div>
                                <div class="content-group mt16">
                                    <field name="pos_salesman_ids" widget="many2many_tags" domain="[('company_id', '=', company_id)]" />
                                </div>
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
