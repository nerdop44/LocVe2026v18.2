<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_igtf_report_wizard_form" model="ir.ui.view">
        <field name="name">igtf.report.wizard.form</field>
        <field name="model">igtf.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte Consolidado IGTF SENIAT">
                <group>
                    <group string="Período y Empresa">
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Control de Declaración SENIAT">
                        <field name="declaration_status_filter"/>
                        <field name="declaration_ref" placeholder="Ej. DECL-IGTF-2026-Q1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" string="Ver en Pantalla (Vista Lista)" type="object" class="btn-primary"/>
                    <button name="action_print_pdf" string="Imprimir PDF SENIAT" type="object" class="btn-success" icon="fa-print"/>
                    <button name="action_mark_as_declared" string="Marcar como Declarado SENIAT" type="object" class="btn-info" icon="fa-check-square-o" confirm="¿Desea marcar todas las operaciones del período seleccionado como DECLARADAS ante el SENIAT?"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Custom Tree View for Consolidated IGTF Report -->
    <record id="view_igtf_consolidated_payment_tree" model="ir.ui.view">
        <field name="name">account.payment.igtf.consolidated.tree</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list string="Consolidado IGTF SENIAT" create="false" delete="false">
                <field name="date"/>
                <field name="name"/>
                <field name="payment_type"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="currency_id"/>
                <field name="amount" sum="Total Divisa ($)"/>
                <field name="igtf_percentage"/>
                <field name="igtf_amount" sum="Total IGTF ($)"/>
                <field name="igtf_rate" string="Tasa BCV (Bs.)"/>
                <field name="bi_igtf_bs" sum="Total Base (Bs.)"/>
                <field name="igtf_amount_bs" sum="Total IGTF a Enterar (Bs.)"/>
                <field name="igtf_declaration_status" widget="badge" decoration-warning="igtf_declaration_status == 'pending'" decoration-success="igtf_declaration_status in ('declared', 'paid')"/>
                <field name="igtf_declaration_ref" string="Planilla SENIAT"/>
                <field name="state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_igtf_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte Consolidado IGTF SENIAT</field>
        <field name="res_model">igtf.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Server Action bound to list view action menu for selected payments -->
    <record id="action_mark_selected_payments_as_declared" model="ir.actions.server">
        <field name="name">Marcar Seleccionados como Declarados ante el SENIAT</field>
        <field name="model_id" ref="account.model_account_payment"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
records.write({
    'igtf_declaration_status': 'declared',
    'igtf_declaration_ref': 'DECL-IGTF-' + datetime.date.today().strftime('%Y%m%d')
})
        </field>
    </record>

    <menuitem id="menu_igtf_report_seniat"
              name="Reporte Consolidado IGTF SENIAT"
              parent="l10n_ve_payment_extension.seniat_reports"
              action="action_igtf_report_wizard"
              sequence="5"
              groups="account.group_account_manager,account.group_account_user"/>
</odoo>
