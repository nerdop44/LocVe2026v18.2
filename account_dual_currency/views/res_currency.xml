<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="view_currency_form_inherit_views_ve" model="ir.ui.view">
            <field name="name">view_currency_form_inherit_views_ve</field>
            <field name="model">res.currency</field>
            <field name="inherit_id" ref="base.view_currency_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="before">
                    <header>
                        <button name="actualizar_tasa" string="Actualizar Tasa BCV" class="oe_highlight" type="object" invisible="name not in ['USD', 'EUR', 'VES', 'VEF'] or not sincronizar"/>
                        <button name="actualizar_facturas" string="Actualizar Facturas" class="oe_highlight" type="object" invisible="not facturas_por_actualizar"/>
                        <button name="actualizar_productos" string="Actualizar Productos" class="oe_highlight" type="object"/>
                        <button name="action_fix_astronomical_prices" string="Restaurar Precios (Emergencia)" class="btn-danger" type="object" confirm="¿Está seguro de querer restaurar los precios? Esto dividirá los precios billonarios por la tasa hasta normalizarlos."/>
                    </header>
                    <div class="alert alert-danger" role="alert" style="margin-bottom:0px;" invisible="not facturas_por_actualizar">
                        <strong>
                            - Existe facturas por actualizar a la nueva tasa
                        </strong>
                    </div>
                </xpath>
                 <xpath expr="//field[@name='active']" position="after">
                     <field name="can_edit_rates" invisible="1"/>
                     <field name="sincronizar"/>
                     <field name="facturas_por_actualizar" invisible="1"/>
                     <field name="act_productos" invisible="not sincronizar"/>
                </xpath>
                <xpath expr="//field[@name='rate_ids']" position="replace">
                    <field name="bcv_rate_ids" groups="account.group_account_readonly,account.group_account_invoice,account.group_account_user,account.group_account_manager,base.group_no_one" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="name" string="Fecha"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="bcv_rate" string="Unidad por USD" digits="[12, 4]"/>
                            <field name="inverse_bcv_rate" string="USD por unidad" digits="[12, 12]"/>
                        </list>
                    </field>
                </xpath>
            </field>
        </record>

        <record id="currency_tree_inherit_ve" model="ir.ui.view">
         <field name="name">currency.list.inherit.increment.precision.ve</field>
         <field name="model">res.currency</field>
         <field name="inherit_id" ref="base.view_currency_tree" />
         <field name="arch" type="xml">
                <xpath expr="//field[@name='rate']" position="before">
                     <field name="inverse_rate"></field>
                </xpath>

         </field>
       </record>

</odoo>