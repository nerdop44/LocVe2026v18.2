<odoo>
    <record id="account_move_form_inherit_v23" model="ir.ui.view">
        <field name="name">account.move.form.inherit.v23</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <!-- Campos Técnicos Invisibles - Agregados al final del sheet para evitar desplazamientos -->
            <xpath expr="//sheet" position="inside">
                <field name="verificar_pagos" invisible="1"/>
                <field name="same_currency" invisible="1"/>
                <field name="edit_trm" invisible="1"/>
                <field name="currency_id_dif" invisible="1"/>
                <field name="company_currency_id" invisible="1"/>
                <field name="currency_vef_id" invisible="1"/>
                <field name="currency_usd_id" invisible="1"/>
            </xpath>

            <!-- Bloque de Tasa: En el grupo derecho del encabezado de la factura -->
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="tax_today" string="Tasa de Factura" readonly="1" force_save="1"/>
                <field name="tax_today_edited" invisible="1"/>
                <field name="acuerdo_moneda" invisible="1"/>
            </xpath>

            <!-- Líneas de Factura: Precio y Subtotal en USD -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <field name="price_unit_usd" string="Precio $" widget='monetary' options="{'currency_field': 'currency_usd_id'}"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="after">
                 <field name="price_subtotal_usd" string="Subtotal $" widget='monetary' options="{'currency_field': 'currency_usd_id'}"/>
            </xpath>

            <!-- Apuntes Contables: Débito/Crédito USD -->
            <xpath expr="//field[@name='line_ids']/list/field[@name='credit']" position="after">
                <field name="tax_today" invisible="1"/>
                <field name="debit_usd" sum="Total $" widget='monetary' options="{'currency_field': 'currency_usd_id'}" invisible="display_type in ('line_section', 'line_note')"/>
                <field name="credit_usd" sum="Total $" widget='monetary' options="{'currency_field': 'currency_usd_id'}" invisible="display_type in ('line_section', 'line_note')"/>
            </xpath>

            <!-- Ocultar Totales Estándar -->
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="invisible">move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')</attribute>
            </xpath>

            <!-- Panel de Totales: Estructura en Tabla (USD / Bs. sin solapamiento) -->
            <xpath expr="//field[@name='tax_totals']" position="before">
                <div class="clearfix me-0 border-0 mb-3"
                     invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')">
                    <table class="table table-sm table-borderless text-end float-end" style="width: auto; min-width: 320px;">
                        <tbody>
                            <tr>
                                <td class="text-start fw-bold pe-3">Base Imponible:</td>
                                <td class="pe-3"><field name="amount_untaxed_usd" widget='monetary' options="{'currency_field': 'currency_usd_id'}" class="d-inline"/></td>
                                <td><field name="amount_untaxed_bs" widget='monetary' options="{'currency_field': 'currency_vef_id'}" class="d-inline"/></td>
                            </tr>
                            <tr>
                                <td class="text-start fw-bold pe-3">IVA (16%):</td>
                                <td class="pe-3"><field name="amount_tax_usd" widget='monetary' options="{'currency_field': 'currency_usd_id'}" class="d-inline"/></td>
                                <td><field name="amount_tax_bs" widget='monetary' options="{'currency_field': 'currency_vef_id'}" class="d-inline"/></td>
                            </tr>
                            <tr class="border-top fw-bold">
                                <td class="text-start pe-3">TOTAL:</td>
                                <td class="pe-3"><field name="amount_total_usd" widget='monetary' options="{'currency_field': 'currency_usd_id'}" class="d-inline"/></td>
                                <td><field name="amount_total_bs" widget='monetary' options="{'currency_field': 'currency_vef_id'}" class="d-inline"/></td>
                            </tr>
                            <tr class="border-top fw-bold text-primary" invisible="state == 'draft'">
                                <td class="text-start pe-3">Saldo / Pendiente:</td>
                                <td class="pe-3"><field name="amount_residual_usd" widget='monetary' options="{'currency_field': 'currency_usd_id'}" class="d-inline"/></td>
                                <td><field name="amount_residual_bs" widget='monetary' options="{'currency_field': 'currency_vef_id'}" class="d-inline"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Vista Lista de Facturas -->
    <record id="account_move_tree_inherit_v23" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.v23</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="after">
                <field name="currency_vef_id" readonly="1" invisible="1"/>
                <field name="amount_total_bs" sum="Total Bs." optional="show" widget="monetary" options="{'currency_field': 'currency_vef_id'}"/>
                <field name="amount_residual_bs" sum="Saldo Bs." optional="show" widget="monetary" options="{'currency_field': 'currency_vef_id'}"/>
            </xpath>
            <xpath expr="//field[@name='amount_total_in_currency_signed']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Asiento Retención IGTF -->
    <record id="account_move_form_inherit_igtf_v23" model="ir.ui.view">
        <field name="name">account.move.form.inherit.igtf.v23</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="move_igtf_id" readonly="1" force_save="1" invisible="not move_igtf_id"/>
                <button name="generar_retencion_igtf" type="object" string="Generar IGTF" 
                        invisible="move_igtf_id or state != 'posted'" class="btn btn-secondary btn-sm mb-2 d-block"/>
            </xpath>
        </field>
    </record>
</odoo>
